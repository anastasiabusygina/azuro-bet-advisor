{
  "name": "azuro-betting-tools",
  "version": "1.0.0",
  "description": "Инструменты для работы с Azuro Protocol",
  "type": "module",
  "scripts": {
    "test": "jest --config jest.config.ts",
    "test:ast": "jest --config jest.config.ts tests/ast/ --no-colors | awk '/console\\.(log|warn|error)/ {printf \"\\n\"; getline; if ($0) print \"   \" $0}'",
    "lint": "eslint . --ext .ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "compile-matches": "npx tsc || true",
    "run-compiled-matches": "node dist/scripts/matches.wrapper.cjs",
    "run-compiled-matches-file": "node dist/scripts/matches.wrapper.cjs --output-file=data/output/matches_output.md",
    "matches": "ts-node src/scripts/matches.ts --format=text",
    "matches:json": "ts-node src/scripts/matches.ts --format=json",
    "matches:sh": "scripts/bash/run_matches.sh",
    "matches:sh:json": "scripts/bash/run_matches.sh --format=json",
    "matches:sh:file": "scripts/bash/run_matches.sh --output-file=matches_output.md",
    "matches:sh:json:file": "scripts/bash/run_matches.sh --format=json --output-file=matches_output.json",
    "buttons": "ts-node src/scripts/buttons.ts --format=text",
    "buttons:json": "ts-node src/scripts/buttons.ts --format=json",
    "test:matches": "ts-node src/scripts/temp-match-test.ts",
    "test:buttons": "ts-node src/scripts/temp-buttons-test.ts",
    "build:matches": "npx tsc -p tsconfig.matches.json",
    "run:matches": "node dist/scripts/matches.js",
    "run:matches:file": "node dist/scripts/matches.js --output-file=data/output/matches_output.md"
  },
  "keywords": [
    "azuro",
    "blockchain",
    "betting"
  ],
  "author": "Anastasia Dev",
  "license": "MIT",
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/estree": "^1.0.6",
    "@types/glob": "^8.1.0",
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.19",
    "@types/node-fetch": "^2.6.4",
    "@typescript-eslint/eslint-plugin": "^8.27.0",
    "@typescript-eslint/parser": "^8.27.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.23.0",
    "glob": "^11.0.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.27.0"
  },
  "dependencies": {
    "@azuro-org/dictionaries": "^3.0.26",
    "dotenv": "^16.4.4",
    "js-yaml": "^4.1.0",
    "node-fetch": "^2.7.0",
    "zod": "^3.24.2"
  }
}
