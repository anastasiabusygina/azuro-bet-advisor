{
  "name": "azuro-betting-tools",
  "version": "1.0.0",
  "description": "Инструменты для работы с Azuro Protocol",
  "scripts": {
    "build": "tsc --skipLibCheck",
    "build:scripts": "tsc -p src/scripts/tsconfig.json --skipLibCheck",
    "build:tests": "tsc -p tests/tsconfig.json --skipLibCheck",
    "build:all": "npm run build && npm run build:scripts && npm run build:tests",
    "validate": "./scripts/build-and-test.sh",
    "fetch": "npm run build:scripts && node dist/scripts/fetchAndFormatMatches.standalone.js",
    "fetch:football": "cross-env SPORT_NAME=Football CHAIN=polygon-mainnet npm run fetch",
    "fetch:basketball": "cross-env SPORT_NAME=Basketball CHAIN=polygon-mainnet npm run fetch",
    "fetch:all": "npm run fetch:football && npm run fetch:basketball",
    "show:matches": "npm run build:scripts && node dist/scripts/showUpcomingMatches.js",
    "get:buttons": "npm run build:scripts && node dist/scripts/getMatchButtons.js",
    "test": "jest --config jest.config.ts",
    "test:config-validation": "jest --config jest.config.ts tests/configValidation.test.ts",
    "test:config-presence": "jest --config jest.config.ts tests/configPresenceValidation.test.ts",
    "test:try-catch": "jest --config jest.config.ts tests/strictTryCatchValidation.test.ts",
    "test:scripts": "jest --config jest.config.ts src/scripts/__tests__",
    "test:all": "npm run test && npm run test:config-presence && npm run test:try-catch && npm run test:scripts",
    "lint": "eslint . --ext .ts",
    "start": "node dist/index.js",
    "advisor:compile": "tsc src/scripts/fetchAndFormatMatches.standalone.ts src/scripts/azuroDictionaries.ts --outDir dist/scripts --skipLibCheck --moduleResolution node --module commonjs --target ES2020 --esModuleInterop",
    "advisor": "npm run advisor:compile && node dist/scripts/src/scripts/fetchAndFormatMatches.standalone.js",
    "run:all": "npm run fetch:all && npm run show:matches && npm run get:buttons"
  },
  "keywords": [
    "azuro",
    "blockchain",
    "betting"
  ],
  "author": "Anastasia Dev",
  "license": "MIT",
  "devDependencies": {
    "@babel/preset-env": "^7.22.0",
    "@babel/preset-typescript": "^7.22.0",
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.19",
    "@types/node-fetch": "^2.6.4",
    "@typescript-eslint/parser": "^8.27.0",
    "@typescript-eslint/typescript-estree": "^8.27.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "cross-env": "^7.0.3",
    "glob": "^11.0.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@azuro-org/dictionaries": "^3.0.26",
    "@urql/core": "^5.1.1",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.4",
    "graphql": "^16.10.0",
    "graphql-tag": "^2.12.6",
    "node-fetch": "^2.7.0",
    "viem": "^2.23.14",
    "zod": "^3.24.2"
  }
}
